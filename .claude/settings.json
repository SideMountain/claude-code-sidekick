{
  "permissions": {
    "allow": [
      "Bash(*)",
      "Read(*)",
      "Grep(*)",
      "Glob(*)",
      "Edit(*)",
      "Write(*)",
      "Skill(*)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "WebFetch(domain:api.github.com)",
      "WebSearch"
    ],
    "deny": [
      "Bash(npx prisma db push:*)",
      "Bash(prisma db push:*)",
      "Bash(git push --force:*)",
      "Bash(git push --force-with-lease:*)",
      "Bash(git push -f:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "type": "command",
        "command": ".claude/hooks/session-start.sh",
        "timeout": 15000
      }
    ],
    "UserPromptSubmit": [
      {
        "type": "command",
        "command": ".claude/hooks/prompt-reminder.sh",
        "timeout": 5000
      }
    ],
    "PreToolUse": [
      {
        "type": "command",
        "command": ".claude/hooks/guard-protected-branch-edit.sh",
        "timeout": 10000,
        "toolNames": [
          "Edit",
          "Write"
        ]
      },
      {
        "type": "command",
        "command": ".claude/hooks/guard-bash.sh",
        "timeout": 10000,
        "toolNames": [
          "Bash"
        ]
      },
      {
        "type": "command",
        "command": ".claude/hooks/guard-commit-message.sh",
        "timeout": 10000,
        "toolNames": [
          "Bash"
        ]
      },
      {
        "type": "command",
        "command": ".claude/hooks/guard-db-operation.sh",
        "timeout": 10000,
        "toolNames": [
          "Bash"
        ]
      }
    ],
    "Stop": []
  }
}